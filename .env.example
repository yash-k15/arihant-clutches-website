
# ==========================================
# SERVER
# ==========================================
PORT=4000
CLIENT_URL=http://localhost:3000

# ==========================================
# DATABASE
# ==========================================
MONGO_URI=your_mongodb_connection_string

# ==========================================
# AUTHENTICATION
# ==========================================
JWT_SECRET=replace_with_a_long_random_secret

# ==========================================
# CLOUDINARY
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# RAZORPAY
# ==========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ==========================================
# GENERAL EMAIL
# Order confirmations and contact enquiries
# ==========================================
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_EMAIL=your_smtp_email
SMTP_PASSWORD=your_smtp_password
FROM_NAME=Your Store Name
FROM_EMAIL=your_sender_email

# ==========================================
# AUTHENTICATION EMAIL
# OTP and password reset emails
# ==========================================
AUTH_SMTP_HOST=your_auth_smtp_host
AUTH_SMTP_PORT=465
AUTH_SMTP_EMAIL=your_auth_smtp_email
AUTH_SMTP_PASSWORD=your_auth_smtp_password
AUTH_FROM_NAME=Your Store Name
AUTH_FROM_EMAIL=your_auth_sender_email

# ==========================================
# OPTIONAL PAGINATION SETTINGS
# ==========================================
ADMIN_USERS_PER_PAGE=
ADMIN_ORDERS_PER_PAGE=
CUSTOMER_ORDERS_PER_PAGE=
